{
  "phase": "39C",
  "scope": "studio-hq-cloudflare-worker-runtime-and-security-baseline",
  "deployment_model": "cloudflare-worker",
  "worker_name": "jawed-website-ai-studio-lab",
  "entrypoint": "worker.js",
  "wrangler_config": "wrangler.jsonc",
  "build_command": "bun run build",
  "build_output_directory": "dist",
  "assets_binding": "ASSETS",
  "assets_directory": "./dist",
  "functions_directory": "functions",
  "required_runtime_files": [
    "worker.js",
    "wrangler.jsonc",
    "functions/api/ai.js",
    "functions/api/contact.js",
    "functions/api/hq/session.js",
    "functions/api/hq/clients.js",
    "functions/api/hq/projects.js",
    "functions/api/hq/tasks.js",
    "functions/api/hq/milestones.js"
  ],
  "api_routes": [
    "/api/ai",
    "/api/contact",
    "/api/hq/session",
    "/api/hq/clients",
    "/api/hq/projects",
    "/api/hq/tasks",
    "/api/hq/milestones"
  ],
  "lab_origin": "https://lab.jawed.co.in",
  "content_canonical_origin": "https://jawed.co.in",
  "content_canonical_origin_must_be_exact": true,
  "required_worker_security_headers": [
    "X-Frame-Options: DENY",
    "Cross-Origin-Opener-Policy: same-origin",
    "X-Content-Type-Options: nosniff",
    "X-Permitted-Cross-Domain-Policies: none",
    "Referrer-Policy: strict-origin-when-cross-origin",
    "Permissions-Policy: geolocation=(), microphone=(), camera=()",
    "Strict-Transport-Security: max-age=31536000",
    "Content-Security-Policy:"
  ],
  "api_origin_policy": "jawed.co.in-and-subdomains",
  "static_asset_binding_required": true,
  "deployment_scope": "Studio HQ Lab Worker only; no personal-site or Kaushal deployment",
  "build_script": "tsc && vite build && node scripts/prepare-dist.mjs"
}
