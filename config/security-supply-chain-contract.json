{
  "phase": "38C",
  "name": "Secrets, Supply Chain & Repository Security",
  "status": "active",
  "controls": {
    "tracked_secret_files": "blocked",
    "credential_like_literals": "blocked",
    "workflow_untrusted_shell_interpolation": "blocked",
    "workflow_target_elevation": "blocked",
    "workflow_action_sha_pinning": "required",
    "workflow_permissions": "contents-read",
    "workflow_secret_access": "allowlisted-cloudflare-deployment-secrets-only",
    "runtime_dependency_manifest": "package.json-required",
    "dependency_lockfile": "bun.lock-required",
    "firebase_client_configuration": "allowlisted-public-client-config-with-strict-schema"
  },
  "scope": "repository-source-and-github-actions",
  "principle": "Do not introduce dependency, platform, or deployment changes without a concrete finding.",
  "allowed_dependency_manifests": [
    "package.json"
  ]
}
