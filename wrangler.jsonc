{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jawed-website-ai-studio-lab-preview",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "ai": { "binding": "AI" },
  "vars": {
    "ENVIRONMENT": "preview",
    "CANONICAL_ORIGIN": "https://preview.lab.jawed.co.in"
  },
  "d1_databases": [
    {
      "binding": "HQ_DB",
      "database_name": "jawed-studio-hq-preview",
      "database_id": "623a828d-2909-47e7-a228-130b4eeefef5",
      "migrations_dir": "migrations/hq"
    }
  ],
  "ratelimits": [
    { "name": "HQ_SESSION_LIMITER", "namespace_id": "620261117", "simple": { "limit": 10, "period": 60 } },
    { "name": "HQ_WRITE_LIMITER", "namespace_id": "620261118", "simple": { "limit": 30, "period": 60 } },
    { "name": "HQ_RATE_LIMITER", "namespace_id": "620261119", "simple": { "limit": 120, "period": 60 } }
  ],
  "env": {
    "preview": {
      "name": "jawed-website-ai-studio-lab-preview",
      "vars": {
        "ENVIRONMENT": "preview",
        "CANONICAL_ORIGIN": "https://preview.lab.jawed.co.in"
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "HQ_DB",
          "database_name": "jawed-studio-hq-preview",
          "database_id": "623a828d-2909-47e7-a228-130b4eeefef5",
          "migrations_dir": "migrations/hq"
        }
      ],
      "ratelimits": [
        { "name": "HQ_SESSION_LIMITER", "namespace_id": "620261117", "simple": { "limit": 10, "period": 60 } },
        { "name": "HQ_WRITE_LIMITER", "namespace_id": "620261118", "simple": { "limit": 30, "period": 60 } },
        { "name": "HQ_RATE_LIMITER", "namespace_id": "620261119", "simple": { "limit": 120, "period": 60 } }
      ]
    },
    "production": {
      "name": "jawed-website-ai-studio-lab",
      "vars": {
        "ENVIRONMENT": "lab",
        "CANONICAL_ORIGIN": "https://lab.jawed.co.in"
      },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "HQ_DB",
          "database_name": "jawed-studio-hq",
          "database_id": "d9ec83ea-7114-4179-af8e-a22ba5494508",
          "migrations_dir": "migrations/hq"
        }
      ],
      "ratelimits": [
        { "name": "HQ_SESSION_LIMITER", "namespace_id": "620261114", "simple": { "limit": 10, "period": 60 } },
        { "name": "HQ_WRITE_LIMITER", "namespace_id": "620261115", "simple": { "limit": 30, "period": 60 } },
        { "name": "HQ_RATE_LIMITER", "namespace_id": "620261116", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
}
